# Environment for the Whop Edge Functions.
#
# Local:      copy to supabase/functions/.env (git-ignored) and fill in SANDBOX values.
#             `supabase functions serve` loads it automatically.
# Production: never use this file. Set each value with
#             `supabase secrets set NAME=value --project-ref <ref>` (see docs/deployment.md).
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase; do not set them here.
# Never put real values in this example file.

# Whop API key (server-side only). Sandbox key locally, production key in prod.
WHOP_API_KEY=

# Signing secret of the Whop webhook (starts with ws_). Used as the raw HMAC key.
WHOP_WEBHOOK_SECRET=

# Whop company/account id (biz_...). Webhooks from any other account are ignored.
WHOP_COMPANY_ID=

# Whop REST base URL. Local/dev: https://sandbox-api.whop.com/api/v1
# Production: https://api.whop.com/api/v1 (the default when unset).
WHOP_API_BASE_URL=https://sandbox-api.whop.com/api/v1

# Reference only: the functions read plan ids from public.subscription_plans.whop_plan_id.
# Keep these in sync with that table (handy for scripts and the Whop dashboard).
WHOP_PLAN_MONTHLY_ID=
WHOP_PLAN_QUARTERLY_ID=

# Public URL of the Flutter web app. Whop redirects to ${APP_URL}/checkout/return.
APP_URL=http://localhost:3000

# Comma-separated browser origins allowed to call whop-checkout (defaults to APP_URL's origin).
ALLOWED_ORIGINS=http://localhost:3000

# Server-side key for Spanish transcription through Groq Whisper.
GROQ_API_KEY=
